      <FONT FACE="Roboto">end_time</FONT>
      </TD><TD ALIGN="LEFT">
      <FONT FACE="Roboto">TimeField</FONT>
      </TD></TR>
    
    
    
      <TR><TD ALIGN="LEFT" BORDER="0">
      <FONT FACE="Roboto">max_capacity</FONT>
      </TD><TD ALIGN="LEFT">
      <FONT FACE="Roboto">PositiveIntegerField</FONT>
      </TD></TR>
    
    
    
      <TR><TD ALIGN="LEFT" BORDER="0">
      <FONT FACE="Roboto">start_time</FONT>
      </TD><TD ALIGN="LEFT">
      <FONT FACE="Roboto">TimeField</FONT>
      </TD></TR>
    
    
      </TABLE>
      >]

  }


  // Relations
  core_models_User [label=<
  <TABLE BGCOLOR="white" BORDER="0" CELLBORDER="0" CELLSPACING="0">
